FROM rust:alpine3.23
ENV RUSTFLAGS="-C target-feature=-crt-static"
WORKDIR /usr/src/rebuilderd
RUN apk add --no-cache musl-dev pkgconfig
COPY . .
RUN --mount=type=cache,target=/var/cache/buildkit \
    CARGO_HOME=/var/cache/buildkit/cargo \
    CARGO_TARGET_DIR=/var/cache/buildkit/alpine/target \
    cargo build --release --locked -p rebuilderd-worker && \
    cp -v /var/cache/buildkit/alpine/target/release/rebuilderd-worker /

FROM alpine:3.23
# python3 runs stabilizer-alpine.py
RUN apk add --no-cache libgcc python3
COPY --from=0 \
    /usr/src/rebuilderd/worker/rebuilder-alpine.sh \
    /usr/src/rebuilderd/worker/stabilizer-alpine.py \
    /usr/local/libexec/rebuilderd/
COPY --from=0 /rebuilderd-worker /usr/local/bin/
# No rebuild tool is included, add one and set REBUILDERD_ALPINE_REBUILDER,
# see docs/alpine.md.
# REBUILDERD_WORKER_BACKEND can't set a stabilizer, so the backend is
# configured in a config file instead.
RUN printf '%s\n' \
    '[backend."alpine"]' \
    'path = "/usr/local/libexec/rebuilderd/rebuilder-alpine.sh"' \
    'stabilizer = "/usr/local/libexec/rebuilderd/stabilizer-alpine.py"' \
    > /etc/rebuilderd-worker.conf
ENV REBUILDERD_WORKER_CONFIG=/etc/rebuilderd-worker.conf
ENTRYPOINT ["rebuilderd-worker"]
